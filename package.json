{
	"name": "@abdwhb-png/rpiv-todo",
	"version": "2.8.0",
	"description": "Pi extension. A todo list for the model, rendered as a live overlay that survives /reload and conversation compaction.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rpiv",
		"todo"
	],
	"type": "module",
	"license": "MIT",
	"author": "juicesharp",
	"private": true,
	"packageManager": "npm@12.0.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abdwhb-png/rpiv-todo.git"
	},
	"homepage": "https://github.com/abdwhb-png/rpiv-todo#readme",
	"bugs": {
		"url": "https://github.com/abdwhb-png/rpiv-todo/issues"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint .",
		"lint:check": "oxlint --deny-warnings ."
	},
	"files": [
		"config.ts",
		"index.ts",
		"locales/",
		"todo.ts",
		"todo-overlay.ts",
		"LICENSE",
		"docs/",
		"!docs/*.png",
		"!docs/*.jpg",
		"!docs/*.svg",
		"README.md",
		"state/invariants.ts",
		"state/i18n-bridge.ts",
		"state/replay.ts",
		"state/selectors.ts",
		"state/state-reducer.ts",
		"state/state.ts",
		"state/store.ts",
		"state/task-graph.ts",
		"tool/response-envelope.ts",
		"tool/sanitize.ts",
		"tool/types.ts",
		"view/format.ts"
	],
	"pi": {
		"image": "https://raw.githubusercontent.com/abdwhb-png/rpiv-todo/main/docs/cover.png",
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@juicesharp/rpiv-i18n": "*"
	},
	"peerDependenciesMeta": {
		"@juicesharp/rpiv-i18n": {
			"optional": true
		}
	},
	"dependencies": {
		"@juicesharp/rpiv-config": "2.11.0",
		"typebox": "^1.1.24"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3",
		"@juicesharp/rpiv-i18n": "2.7.1",
		"@types/node": "24.13.3",
		"@xterm/headless": "6.0.0",
		"oxlint": "1.80.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
